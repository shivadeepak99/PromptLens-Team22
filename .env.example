# PromptLens Environment Configuration Example

# --- Database / Warehouse ---
# Connection string for the PostgreSQL Data Warehouse (Local or Remote like Neon.tech)
DATABASE_URL=postgresql://user:password@localhost:5432/promptlens

# --- API Layer (FastAPI) ---
# Port for the FastAPI server to run on
API_PORT=8000
# Environment mode (development, staging, production)
ENV_MODE=development
# Secret key for JWT/API authentication (Replace with a secure random string in production)
AUTH_SECRET=your_super_secret_key_here

# --- ML / Analytics ---
# Path to the exported model artifacts (relative or absolute)
MODEL_ARTIFACTS_PATH=./analytics/ml_service/models/

# --- Frontend (Next.js) ---
# The base URL of the FastAPI backend for the Next.js frontend to communicate with
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
